  "aboutTabName": {
    "message": "Tentang Plugin"
  },
  "aboutPluginTitle": {
    "message": "Apa ini"
  },
  "aboutPluginContent": {
    "message": "ChatLine menambahkan timeline, chat tersimpan, ekspor, dan penjalankan kode ke halaman chat AI. Fork dari proyek sumber terbuka Timeline, ChatLine mendukung ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM, dan lainnya."
  },
  "aboutDataSecurityTitle": {
    "message": "Data kamu"
  },
  "aboutDataSecurityContent": {
    "message": "Data kamu tetap ada di browser atau di Google Drive kamu sendiri. Ekstensi ini tidak pernah mengumpulkan, mengunggah, atau membagikan percakapan maupun informasi pribadi kamu. Kodenya bersifat sumber terbuka di GitHub dan bisa ditinjau kapan saja."
  },
  "aboutDeveloperTitle": {
    "message": "Umpan Balik"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine dikelola sebagai fork dari ai-chat-timeline. Untuk meminta fitur atau melaporkan bug, buka issue di repositori proyek."
  },
  "aboutShareTitle": {
    "message": "Ceritakan ke teman"
  },
  "aboutShareContent": {
    "message": "Kalau ChatLine membantu kamu, bagikan ke siapa pun yang sering memakai chat AI. Penulis: 咪咕看见小黑 · miguchn@gmail.com — pertanyaan dan saran diterima kapan saja."
  },
