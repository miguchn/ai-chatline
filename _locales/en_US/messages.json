  "aboutTabName": {
    "message": "About"
  },
  "aboutPluginTitle": {
    "message": "What this is"
  },
  "aboutPluginContent": {
    "message": "ChatLine adds a timeline, saved chats, export, and code running to AI chat pages. Forked from the open-source Timeline project, it works with ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM and more."
  },
  "aboutDataSecurityTitle": {
    "message": "Your data"
  },
  "aboutDataSecurityContent": {
    "message": "Your data stays in your browser or in your own Google Drive. The extension never collects, uploads, or shares your conversations or personal information. The code is open source on GitHub and open to review at any time."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine is maintained as a fork of ai-chat-timeline. To request a feature or report a bug, open an issue in the project repository."
  },
  "aboutShareTitle": {
    "message": "Tell a friend"
  },
  "aboutShareContent": {
    "message": "If ChatLine helps you, pass it along to anyone who spends time in AI chats. Author: 咪咕看见小黑 · miguchn@gmail.com — questions and suggestions welcome any time."
  },
