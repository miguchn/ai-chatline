  "aboutTabName": {
    "message": "À propos"
  },
  "aboutPluginTitle": {
    "message": "Présentation"
  },
  "aboutPluginContent": {
    "message": "ChatLine ajoute une chronologie, des conversations enregistrées, l'exportation et l'exécution de code aux pages de chat IA. Issue du projet open-source Timeline, elle fonctionne avec ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM et bien d'autres."
  },
  "aboutDataSecurityTitle": {
    "message": "Vos données"
  },
  "aboutDataSecurityContent": {
    "message": "Vos données restent dans votre navigateur ou dans votre propre Google Drive. L'extension ne collecte, ne téléverse ni ne partage jamais vos conversations ou vos informations personnelles. Le code est open source sur GitHub, consultable à tout moment."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine est maintenu comme un fork de ai-chat-timeline. Pour demander une fonctionnalité ou signaler un bug, ouvrez une issue sur le dépôt du projet."
  },
  "aboutShareTitle": {
    "message": "Parlez-en à un ami"
  },
  "aboutShareContent": {
    "message": "Si ChatLine vous est utile, partagez-le avec toute personne qui passe du temps dans les chats IA. Auteur : 咪咕看见小黑 · miguchn@gmail.com — questions et suggestions bienvenues à tout moment."
  },
