  "aboutTabName": {
    "message": "Giới thiệu"
  },
  "aboutPluginTitle": {
    "message": "ChatLine là gì"
  },
  "aboutPluginContent": {
    "message": "ChatLine thêm dòng thời gian, hội thoại đã lưu, xuất hội thoại và chạy mã vào các trang chat AI. Được fork từ dự án mã nguồn mở Timeline, ChatLine hoạt động với ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM và nhiều nền tảng khác."
  },
  "aboutDataSecurityTitle": {
    "message": "Dữ liệu của bạn"
  },
  "aboutDataSecurityContent": {
    "message": "Dữ liệu của bạn ở lại trong trình duyệt của bạn hoặc trong Google Drive của riêng bạn. Tiện ích không bao giờ thu thập, tải lên hay chia sẻ hội thoại hoặc thông tin cá nhân của bạn. Mã nguồn mở trên GitHub và có thể kiểm tra bất cứ lúc nào."
  },
  "aboutDeveloperTitle": {
    "message": "Phản hồi"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine được duy trì dưới dạng fork của ai-chat-timeline. Muốn đề xuất tính năng hoặc báo lỗi, hãy mở issue trong repository của dự án."
  },
  "aboutShareTitle": {
    "message": "Giới thiệu cho bạn bè"
  },
  "aboutShareContent": {
    "message": "Nếu ChatLine hữu ích với bạn, hãy giới thiệu cho bất kỳ ai hay chat với AI. Tác giả: 咪咕看见小黑 · miguchn@gmail.com — có câu hỏi hay góp ý, cứ gửi bất cứ lúc nào."
  },
