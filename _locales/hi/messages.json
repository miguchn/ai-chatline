  "aboutPluginTitle": {
    "message": "यह क्या है"
  },
  "aboutPluginContent": {
    "message": "ChatLine AI चैट पेजों में टाइमलाइन, सहेजी गई चैट, एक्सपोर्ट और कोड रन करने की सुविधा जोड़ता है। ओपन-सोर्स Timeline प्रोजेक्ट पर आधारित fork, यह ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM और कई अन्य के साथ काम करता है।"
  },
  "aboutDataSecurityTitle": {
    "message": "आपका डेटा"
  },
  "aboutDataSecurityContent": {
    "message": "आपका डेटा आपके ब्राउज़र या आपके अपने Google Drive में रहता है। एक्सटेंशन आपकी बातचीत या व्यक्तिगत जानकारी को कभी एकत्र, अपलोड या साझा नहीं करता। कोड GitHub पर ओपन-सोर्स है और किसी भी समय समीक्षा के लिए खुला है।"
  },
  "aboutDeveloperTitle": {
    "message": "फ़ीडबैक"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine को ai-chat-timeline के fork के रूप में बनाए रखा जाता है। फीचर अनुरोध या bug रिपोर्ट के लिए प्रोजेक्ट repository में issue खोलें।"
  },
  "aboutShareTitle": {
    "message": "किसी दोस्त को बताएं"
  },
  "aboutShareContent": {
    "message": "यदि ChatLine आपके काम आता है, तो इसे उन लोगों तक पहुंचाएं जो AI चैट में समय बिताते हैं। लेखक: 咪咕看见小黑 · miguchn@gmail.com — सवाल और सुझाव कभी भी स्वागत हैं।"
  },
