  "aboutTabName": {
    "message": "Acerca de"
  },
  "aboutPluginTitle": {
    "message": "Qué es esto"
  },
  "aboutPluginContent": {
    "message": "ChatLine agrega una línea de tiempo, chats guardados, exportación y ejecución de código a las páginas de chat con IA. Es un fork del proyecto open-source Timeline y funciona con ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM y más."
  },
  "aboutDataSecurityTitle": {
    "message": "Tus datos"
  },
  "aboutDataSecurityContent": {
    "message": "Tus datos permanecen en tu navegador o en tu propio Google Drive. La extensión nunca recopila, sube ni comparte tus conversaciones ni tu información personal. El código es open source en GitHub y puedes revisarlo cuando quieras."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine se mantiene como un fork de ai-chat-timeline. Para pedir una función o reportar un error, abre un issue en el repositorio del proyecto."
  },
  "aboutShareTitle": {
    "message": "Compártelo con un amigo"
  },
  "aboutShareContent": {
    "message": "Si ChatLine te ayuda, compártelo con quien pase tiempo en chats con IA. Autor: 咪咕看见小黑 · miguchn@gmail.com — preguntas y sugerencias bienvenidas cuando quieras."
  },
