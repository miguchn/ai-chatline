  "aboutTabName": {
    "message": "Info"
  },
  "aboutPluginTitle": {
    "message": "Che cos'è"
  },
  "aboutPluginContent": {
    "message": "ChatLine aggiunge timeline, chat salvate, esportazione ed esecuzione di codice alle pagine di chat IA. Nata come fork del progetto open source Timeline, funziona con ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM e altre."
  },
  "aboutDataSecurityTitle": {
    "message": "I tuoi dati"
  },
  "aboutDataSecurityContent": {
    "message": "I tuoi dati restano nel tuo browser o nel tuo Google Drive. L'estensione non raccoglie, carica o condivide le tue conversazioni né le tue informazioni personali. Il codice è open source su GitHub e consultabile in qualsiasi momento."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine è mantenuto come fork di ai-chat-timeline. Per richiedere funzionalità o segnalare bug, apri una issue nel repository del progetto."
  },
  "aboutShareTitle": {
    "message": "Dillo a un amico"
  },
  "aboutShareContent": {
    "message": "Se ChatLine ti è utile, consiglialo a chi passa tempo nelle chat IA. Autore: 咪咕看见小黑 · miguchn@gmail.com — domande e suggerimenti sono sempre benvenuti."
  },
