  "aboutTabName": {
    "message": "O rozszerzeniu"
  },
  "aboutPluginTitle": {
    "message": "Co to jest"
  },
  "aboutPluginContent": {
    "message": "ChatLine dodaje do stron czatu AI oś czasu, zapisane rozmowy, eksport i uruchamianie kodu. To fork open-source projektu Timeline; działa z ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM i innymi."
  },
  "aboutDataSecurityTitle": {
    "message": "Twoje dane"
  },
  "aboutDataSecurityContent": {
    "message": "Twoje dane zostają w przeglądarce lub na Twoim Google Drive. Rozszerzenie nigdy nie zbiera, nie przesyła ani nie udostępnia Twoich rozmów ani danych osobowych. Kod jest open-source na GitHubie i można go przejrzeć w każdej chwili."
  },
  "aboutDeveloperTitle": {
    "message": "Opinie"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine jest rozwijany jako fork ai-chat-timeline. Aby zaproponować funkcję lub zgłosić błąd, otwórz issue w repozytorium projektu."
  },
  "aboutShareTitle": {
    "message": "Poleć znajomym"
  },
  "aboutShareContent": {
    "message": "Jeśli ChatLine Ci pomaga, poleć go każdemu, kto spędza czas w czatach AI. Autor: 咪咕看见小黑 · miguchn@gmail.com — pytania i sugestie mile widziane w każdej chwili."
  },
