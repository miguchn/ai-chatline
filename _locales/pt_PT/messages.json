  "aboutTabName": {
    "message": "Sobre"
  },
  "aboutPluginTitle": {
    "message": "O que é isto"
  },
  "aboutPluginContent": {
    "message": "O ChatLine adiciona uma cronologia, conversas guardadas, exportação e execução de código às páginas de chat com IA. É um fork do projeto open-source Timeline e funciona com o ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM, entre outros."
  },
  "aboutDataSecurityTitle": {
    "message": "Os seus dados"
  },
  "aboutDataSecurityContent": {
    "message": "Os seus dados ficam no seu navegador ou no seu próprio Google Drive. A extensão nunca recolhe, envia ou partilha as suas conversas ou informações pessoais. O código é open source no GitHub e pode ser revisto a qualquer momento."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "O ChatLine é mantido como um fork do ai-chat-timeline. Para pedir uma funcionalidade ou reportar um bug, abra um issue no repositório do projeto."
  },
  "aboutShareTitle": {
    "message": "Conte a um amigo"
  },
  "aboutShareContent": {
    "message": "Se o ChatLine lhe é útil, partilhe-o com quem passa tempo em chats com IA. Autor: 咪咕看见小黑 · miguchn@gmail.com — questões e sugestões são bem-vindas a qualquer momento."
  },
