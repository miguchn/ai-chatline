  "aboutTabName": {
    "message": "Über"
  },
  "aboutPluginTitle": {
    "message": "Was das ist"
  },
  "aboutPluginContent": {
    "message": "ChatLine ergänzt KI-Chatseiten um eine Timeline, gespeicherte Chats, Export und Code-Ausführung. Als Fork des Open-Source-Projekts Timeline unterstützt es ChatGPT, Gemini, DeepSeek, Kimi, Qwen, Claude, Yuanbao, NotebookLM und viele mehr."
  },
  "aboutDataSecurityTitle": {
    "message": "Ihre Daten"
  },
  "aboutDataSecurityContent": {
    "message": "Ihre Daten bleiben in Ihrem Browser oder in Ihrem eigenen Google Drive. Die Erweiterung sammelt, übermittelt oder teilt Ihre Unterhaltungen und persönlichen Informationen niemals. Der Code ist Open Source auf GitHub und kann jederzeit überprüft werden."
  },
  "aboutDeveloperTitle": {
    "message": "Feedback"
  },
  "aboutDeveloperContent": {
    "message": "ChatLine wird als Fork von ai-chat-timeline gepflegt. Für Feature-Wünsche oder Fehlerberichte öffnen Sie bitte ein Issue im Projekt-Repository."
  },
  "aboutShareTitle": {
    "message": "Weitersagen"
  },
  "aboutShareContent": {
    "message": "Wenn ChatLine Ihnen hilft, geben Sie es gerne an alle weiter, die viel Zeit in KI-Chats verbringen. Autor: 咪咕看见小黑 · miguchn@gmail.com — Fragen und Anregungen sind jederzeit willkommen."
  },
